; HL+BC+HL
; 1707 F0C4 4C6B
ORG 918h

; Загружаем значения
LXI H, 1707h
LXI B, 0F0C4h

; Будем записывать сумму в DE
MOV D, H
MOV E, L

; # DE = DE + BC
; Складываем младшие разряды (E+C)
MOV A, E
ADD C
; младший разряд в E
MOV E, A

; Старшие разряды (D+B)
MOV A, D
ADC B ; Складываем с переносом, добавляем Carry от ADD
; старший разряд в D
MOV D, A

; Загружаем последнее значение
LXI H, 4C6Bh

; # DE = DE + HL
; Складываем младшие разряды (E+L)
MOV A, E
ADD L
; младший разряд в E
MOV E, A
; Складываем младшие разряды (D+H)
MOV A, D
ADC H ; Складываем с переносом, добавляем Carry от ADD
; старший разряд в D
MOV D, A